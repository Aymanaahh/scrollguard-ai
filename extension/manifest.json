{
  "manifest_version": 3,
  "name": "ScrollGuard AI",
  "version": "1.0",
  "description": "Real-time scam link guard that detects and flags suspicious URLs while you scroll.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
